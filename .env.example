# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/ledgerflow
# For MongoDB Atlas: mongodb+srv://user:password@cluster.mongodb.net/ledgerflow

# JWT Secret Key (change in production!)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production

# Gmail OAuth2 Configuration
# Get these from Google Cloud Console:
# 1. Create OAuth 2.0 credentials (Desktop Application)
# 2. Download JSON and extract CLIENT_ID and CLIENT_SECRET
# 3. Use Google OAuth2 playground or similar to get REFRESH_TOKEN
EMAIL_USER=your-email@gmail.com
CLIENT_ID=your-google-oauth-client-id
CLIENT_SECRET=your-google-oauth-client-secret
REFRESH_TOKEN=your-google-refresh-token
